{
  "name": "sorci",
  "version": "0.6.7",
  "description": "Library to be able to do event sourcing without worrying about the aggregate.",
  "author": "Sraleik",
  "license": "MIT",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && vite build",
    "build:docs": "typedoc --skipErrorChecking && cp -r ./image ./docs/image",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern 'src/sandbox.ts'",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --ignore-pattern 'src/sandbox.ts'",
    "test": "vitest --config ./vitest.config.ts --run",
    "test:watch": "vitest --config ./vitest.config.ts",
    "bench": "tsx ./src/sorci.bench.ts",
    "bench:watch": "tsx watch ./src/sorci.bench.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sraleik/sorci.git"
  },
  "bugs": {
    "url": "https://github.com/sraleik/sorci/issues"
  },
  "keywords": [
    "event-sourcing",
    "postgres"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/sorci.js",
  "type": "module",
  "module": "./dist/sorci.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sorci.js",
      "require": "./dist/sorci.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "postgres": "^3.4.7",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.0.1",
    "@knodes/typedoc-plugin-pages": "^0.23.4",
    "@testcontainers/postgresql": "^11.7.2",
    "@types/node": "^20.3.1",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "nanoid": "^4.0.2",
    "prettier": "^3.0.0",
    "tinybench": "^2.5.0",
    "tsx": "^3.12.7",
    "typedoc": "^0.28.14",
    "typescript": "^5.1.3",
    "uuid": "^9.0.0",
    "vite": "^4.3.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.3"
  }
}
